# ---- Neon Postgres ----
# Neon 控制台 → Connection string → 勾选 "Pooled connection"
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- 凭据加密 ----
# 所有 LiveKit api_secret / WHIP stream_key 用这把钥匙做 AES-256-GCM 加密后落库。
# 生成：npm run keygen        (32 字节 base64)
# 一旦设定不可更换，换了以后已存的节点凭据全部解不开。
CREDENTIAL_ENCRYPTION_KEY=""

# ---- 站点地址（可选）----
# 用于拼 LiveKit webhook 回调地址。不设时会从请求头推导——Vercel preview 部署上
# 反而更准（NEXT_PUBLIC_* 是构建期内联的，写死会导致 preview 域名对不上）。
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- 初始化守卫（可选但强烈建议）----
# 设了这个值，/setup 首次初始化时必须填对，防止公网上被人抢先初始化成管理员。
SETUP_TOKEN=""

# ---- 定时任务保护（部署到 Vercel 时建议设）----
# 保护 /api/cron/cleanup，防止被公网随意触发。
CRON_SECRET=""
