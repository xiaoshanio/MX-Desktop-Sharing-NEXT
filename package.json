{
  "name": "mx-desktop-sharing-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-on-build.mjs && next build",
    "build:only": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"tests/**/*.test.mts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.0",
    "@neondatabase/serverless": "^1.0.0",
    "drizzle-orm": "^0.44.0",
    "gsap": "^3.15.0",
    "livekit-client": "^2.15.0",
    "livekit-server-sdk": "^2.13.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0"
  }
}
